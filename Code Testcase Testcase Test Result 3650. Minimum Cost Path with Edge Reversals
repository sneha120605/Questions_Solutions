import java.util.*;

class Solution {
    public int minCost(int n, int[][] edges) {
        Map<Integer, List<int[]>> graph = new HashMap<>();

        for (int[] edge : edges) {
            int src = edge[0];
            int dest = edge[1];
            int cost = edge[2];

            graph.computeIfAbsent(src, k -> new ArrayList<>())
                 .add(new int[]{dest, cost});

            graph.computeIfAbsent(dest, k -> new ArrayList<>())
                 .add(new int[]{src, 2 * cost});
        }

        return dijkstra(n, graph);
    }

    int dijkstra(int n, Map<Integer, List<int[]>> graph) {
        int[] cost = new int[n];
        Arrays.fill(cost, Integer.MAX_VALUE);
        cost[0] = 0;

        HashSet<Integer> visited = new HashSet<>();

        PriorityQueue<int[]> pq = new PriorityQueue<>(
            (a, b) -> Integer.compare(a[1], b[1])
        );

        pq.offer(new int[]{0, 0});

        while (!pq.isEmpty()) {
            int[] curr = pq.poll();
            int node = curr[0];
            int costSoFar = curr[1];

            if (node == n - 1) {
                return costSoFar;
            }

            if (visited.contains(node)) continue;
            visited.add(node);

            List<int[]> list = graph.get(node);
            if (list == null) continue;

            for (int[] edge : list) {
                int nextNode = edge[0];
                int edgeCost = edge[1];
                int total = costSoFar + edgeCost;

                if (total < cost[nextNode]) {
                    cost[nextNode] = total;
                    pq.offer(new int[]{nextNode, total});
                }
            }
        }
        return -1;
    }
}
