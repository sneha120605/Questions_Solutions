class Solution {
    public int binaryGap(int n) {
        int ones_count=0;
        int count=0;
        int ones=0;
        int index=-1;
        String str=Integer.toBinaryString(n);
        for(int i=0;i<str.length();i++){
            if(str.charAt(i)=='1') {
                ones_count++;
                ones=i;
                if(index!=-1){
                    int gap=ones-index;
                    if(gap>count) count=gap;
                }
                index=ones;
            }
           
        }
        if(ones_count<=1) return 0;
        return count;
    }
}
