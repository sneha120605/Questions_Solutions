class Solution {
    public int minMoves(int[] nums) {
        int count=0;
        int max_element = Arrays.stream(nums).max().getAsInt();
        for(int i=0;i<=nums.length-1;i++){
            if(nums[i]!=max_element) {
                while(nums[i]!=max_element){
                     nums[i]+=1;
                     count++;
                }
                }
        }
    return count;
    }
}
